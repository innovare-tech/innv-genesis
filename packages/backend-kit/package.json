{
  "name": "@innovare-tech/backend-kit",
  "version": "0.1.4",
  "description": "Toolkit opinativa para backends NestJS — repositórios, exceções, guards, decorators, paginação e multi-tenancy.",
  "author": "Innovare",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/innovare-tech/innv-genesis.git",
    "directory": "packages/backend-kit"
  },
  "bugs": {
    "url": "https://github.com/innovare-tech/innv-genesis/issues"
  },
  "homepage": "https://github.com/innovare-tech/innv-genesis/tree/main/packages/backend-kit#readme",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "jest --coverage --passWithNoTests",
    "test:watch": "jest --watch",
    "build:clean": "rimraf dist",
    "build:cjs": "tsc -p tsconfig.build-cjs.json",
    "build:esm": "tsc -p tsconfig.build-esm.json",
    "build:types": "tsc -p tsconfig.build-types.json",
    "build": "npm run build:clean && npm run build:cjs && npm run build:esm && npm run build:types",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@nestjs/event-emitter": "^3.0.0",
    "bcrypt": "^6.0.0",
    "tslib": "^2.6.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/jwt": "^10.0.0 || ^11.0.0",
    "@nestjs/mongoose": "^10.0.0 || ^11.0.0",
    "@nestjs/swagger": "^7.0.0 || ^8.0.0 || ^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "mongoose": "^8.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/config": {
      "optional": true
    },
    "@nestjs/jwt": {
      "optional": true
    },
    "@nestjs/swagger": {
      "optional": true
    },
    "class-transformer": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    },
    "@nestjs/mongoose": {
      "optional": true
    },
    "mongoose": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/testing": "^11.1.7",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "jest": "^29.7.0",
    "mongodb": "^6.12.0",
    "mongoose": "^8.13.0",
    "prettier": "^3.2.5",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^5.0.7",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.4.5",
    "typescript": "^5.4.5"
  },
  "keywords": [
    "nestjs",
    "nest",
    "backend",
    "toolkit",
    "repository",
    "guards",
    "decorators",
    "pagination",
    "multi-tenant",
    "opinionated"
  ]
