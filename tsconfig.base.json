{
  "compilerOptions": {
    /* Base */
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021"],
    "declaration": true,
    "sourceMap": true,
    "importHelpers": true,
    "removeComments": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Regras de Ouro (Sua exigência) */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Regras do Nexus (Decorators) */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    /* Resolução */
    "moduleResolution": "node",
    "skipLibCheck": true
  }
}